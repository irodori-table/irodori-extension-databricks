{
  "schemaVersion": 1,
  "extensionId": "irodori.databricks",
  "visibility": "public",
  "version": "0.1.1",
  "connector": {
    "id": "databricks.connector",
    "engine": "databricks",
    "label": "Databricks",
    "aliases": [
      "databricks",
      "Databricks / Spark SQL",
      "Databricks"
    ],
    "defaultPort": 443,
    "wire": "jdbc",
    "module": "databricks.driver",
    "features": [
      "metadata",
      "sql",
      "explain"
    ]
  },
  "connection": {
    "endpoint": {
      "modes": [
        "hostPort",
        "connectionString"
      ],
      "defaultPort": 443,
      "fields": [
        {
          "id": "host",
          "label": "Host",
          "type": "string",
          "profileField": "host",
          "required": true
        },
        {
          "id": "port",
          "label": "Port",
          "type": "number",
          "profileField": "port",
          "default": 443
        },
        {
          "id": "httpPath",
          "label": "HTTP path",
          "type": "string",
          "option": "httpPath",
          "required": true
        },
        {
          "id": "database",
          "label": "Schema",
          "type": "string",
          "profileField": "database",
          "option": "ConnSchema",
          "default": "default"
        },
        {
          "id": "catalog",
          "label": "Catalog",
          "type": "string",
          "option": "ConnCatalog",
          "default": "SPARK"
        }
      ]
    },
    "authMethods": [
      "none",
      "connectionString",
      "databricksPersonalAccessToken",
      "databricksOAuthToken",
      "databricksOAuthU2M",
      "databricksOAuthM2M",
      "databricksAzureManagedIdentity",
      "customDriverOptions"
    ],
    "tls": "required",
    "transports": "default",
    "optionNamespaces": [
      "jdbc",
      "databricks",
      "oauth",
      "azure"
    ],
    "customDriverOptions": true
  },
  "runtime": {
    "driverLinked": true
  },
  "source": {
    "knowledgeEngineStatus": "recognized_no_connector",
    "adapter": null
  }
}
